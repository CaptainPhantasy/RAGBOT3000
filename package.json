{
	"name": "ragbot-web-analyzer",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:web": "vite",
		"dev:server": "ALLOW_INSECURE_LOCAL_DEV=1 PORT=3001 node server.mjs",
		"format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false --files-ignore-unknown=true App.tsx index.tsx vite.config.ts components hooks services lib scripts tests tailwind.config.cjs postcss.config.cjs package.json railway.json nixpacks.toml",
		"format:write": "biome format --write --files-ignore-unknown=true .",
		"lint": "oxlint .",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.mjs && vitest run",
		"test:watch": "vitest",
		"build": "vite build",
		"bundle:check": "node scripts/assert-no-client-secrets.mjs",
		"browser:proof": "node scripts/verify-extension-browser.mjs",
		"extension:check": "npm --prefix extension run check",
		"preview": "vite preview",
		"start": "node server.mjs",
		"audit:prod": "npm audit --omit=dev --audit-level=moderate",
		"audit:full": "npm audit --include=dev --audit-level=moderate",
		"secrets": "secretlint --secretlintrc .secretlintrc.json \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,html,css}\"",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run bundle:check && npm run extension:check && npm run audit:prod && npm run audit:full && npm run secrets"
	},
	"dependencies": {
		"@google/genai": "^1.34.0",
		"@tsparticles/engine": "^3.9.1",
		"@tsparticles/react": "^3.0.0",
		"@tsparticles/slim": "^3.9.1",
		"clsx": "^2.1.1",
		"motion": "^12.23.26",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"simplex-noise": "^4.0.1",
		"tailwind-merge": "^2.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@secretlint/secretlint-rule-preset-recommend": "^11.2.5",
		"@types/node": "^22.14.0",
		"@vitejs/plugin-react": "^5.2.0",
		"autoprefixer": "^10.5.3",
		"jsdom": "^25.0.1",
		"oxlint": "^1.33.0",
		"postcss": "^8.5.19",
		"secretlint": "^11.2.5",
		"tailwindcss": "^3.4.19",
		"typescript": "~5.8.2",
		"vite": "^6.4.3",
		"vitest": "^3.2.7"
	}
}

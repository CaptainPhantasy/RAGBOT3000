# Server-only Gemini credential. Never expose this through Vite or VITE_* variables.
GEMINI_API_KEY=

# Required in production. Users enter this value once per browser session.
APP_ACCESS_TOKEN=

# Comma-separated browser origins allowed to call the server API.
ALLOWED_ORIGINS=http://localhost:3000

# Optional local-only bypass for the paired Vite/server dev command.
ALLOW_INSECURE_LOCAL_DEV=1

# Optional Qdrant service used by the browser retrieval fallback.
VITE_QDRANT_API_URL=http://localhost:8080
VITE_USE_VECTOR_SEARCH=true
